# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+91xxxxxxxxxx

# Channel to scrape
TELEGRAM_CHANNEL=ranjitoptions

# Scraper settings
MAX_MESSAGES=0
BATCH_SIZE=100

# OCR settings: "tesseract" or "easyocr"
OCR_ENGINE=easyocr
OCR_WORKERS=4
